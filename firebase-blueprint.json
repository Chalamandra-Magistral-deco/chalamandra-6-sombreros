{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and metadata",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User's full name or display handle"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "User's email address"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User's profile picture URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation ISO timestamp"
        }
      },
      "required": ["email"]
    },
    "HatsRitual": {
      "title": "Seis Sombreros Ritual",
      "description": "Strategic evaluation using Edward de Bono's Six Thinking Hats methodology",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Title or summary of the conflict analyzed"
        },
        "azotea": {
          "type": "string",
          "maxLength": 1000,
          "description": "The conflict or situation definition"
        },
        "blanco": {
          "type": "string",
          "maxLength": 2000,
          "description": "White hat facts and data"
        },
        "rojo": {
          "type": "string",
          "maxLength": 2000,
          "description": "Red hat feelings and intuition"
        },
        "negro": {
          "type": "string",
          "maxLength": 2000,
          "description": "Black hat risks and criticism"
        },
        "amarillo": {
          "type": "string",
          "maxLength": 2000,
          "description": "Yellow hat benefits and optimism"
        },
        "verde": {
          "type": "string",
          "maxLength": 2000,
          "description": "Green hat creative alternatives"
        },
        "azul": {
          "type": "string",
          "maxLength": 2000,
          "description": "Blue hat action plan and command"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp"
        }
      },
      "required": ["title", "azotea", "azul"]
    },
    "LadderRitual": {
      "title": "Escalera Estratégica Ritual",
      "description": "Multi-tier human interaction analysis ritual",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Title or summary of the interaction analyzed"
        },
        "instinto": {
          "type": "string",
          "maxLength": 2000,
          "description": "Visceral signal or instinct"
        },
        "emocion": {
          "type": "string",
          "maxLength": 2000,
          "description": "Psychological trap or induced emotion"
        },
        "jugada": {
          "type": "string",
          "maxLength": 2000,
          "description": "Strategic play identified"
        },
        "posicion": {
          "type": "string",
          "maxLength": 2000,
          "description": "Roles and positioning"
        },
        "ejecucion": {
          "type": "string",
          "maxLength": 2000,
          "description": "Countermove execution plan"
        },
        "bitacora": {
          "type": "string",
          "maxLength": 2000,
          "description": "Pattern log entry"
        },
        "inmunidad": {
          "type": "string",
          "maxLength": 2000,
          "description": "Mental immunity affirmation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp"
        }
      },
      "required": ["title", "instinto", "ejecucion"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/hats_rituals/{ritualId}": {
      "schema": { "$ref": "#/entities/HatsRitual" },
      "description": "Collection of Six Thinking Hats decision rituals created by the user"
    },
    "/users/{userId}/ladder_rituals/{ritualId}": {
      "schema": { "$ref": "#/entities/LadderRitual" },
      "description": "Collection of Strategic Ladder interaction rituals created by the user"
    }
  }
}
