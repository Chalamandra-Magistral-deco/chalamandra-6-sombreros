rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId)
        && incoming().email is string
        && incoming().email.size() <= 150;
      allow delete: if false;

      // User's Six Thinking Hats rituals subcollection
      match /hats_rituals/{ritualId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(ritualId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(ritualId)
          && incoming().title is string && incoming().title.size() <= 200
          && incoming().azotea is string && incoming().azotea.size() <= 1500;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(ritualId);
      }

      // User's Strategic Ladder rituals subcollection
      match /ladder_rituals/{ritualId} {
        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(ritualId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(ritualId)
          && incoming().title is string && incoming().title.size() <= 200
          && incoming().instinto is string && incoming().instinto.size() <= 2500;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(ritualId);
      }
    }
  }
}
